# Application Configuration
APP_NAME="Dental AI Study & Research Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dental_agent_db"
DATABASE_SYNC_URL="postgresql+psycopg://postgres:postgres@localhost:5432/dental_agent_db"

# Security & Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER="groq"
ENABLE_GEMINI=true

# Groq Configuration (Fast conversational inference, query classification, basic tutoring, MCQs)
GROQ_API_KEY="gsk_placeholder_replace_with_real_groq_key"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=30.0

# Google Gemini Configuration (Complex synthesis, multi-paper research, long-context, multimodal)
GEMINI_API_KEY="placeholder_replace_with_real_gemini_key"
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_FLASH_MODEL="gemini-1.5-flash"
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=60.0

# Embedding Configuration
# Options: "fastembed" (local zero-cost BAAI/bge-small-en-v1.5) or "gemini"
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384

# Document Processing & RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25
UPLOAD_STORAGE_DIR="./uploads"

# Scholarly & Web Research APIs
# NCBI PubMed (no key required for low rate limits, optional key for 10 req/sec)
NCBI_API_KEY=""
EUROPE_PMC_BASE_URL="https://www.ebi.ac.uk/europepmc/webservices/rest"
CROSSREF_BASE_URL="https://api.crossref.org"
TAVILY_API_KEY=""
RESEARCH_MAX_RESULTS=5
